# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── AI provider ────────────────────────────────────────────────────────────
# The backend uses Groq (OpenAI-compatible) by default. Get a free key at
# https://console.groq.com/keys . Without a key, the app automatically falls
# back to a deterministic rule-based extractor, so it still runs end to end.
GROQ_API_KEY=gsk_your_key_here

# Force a provider: "groq" or "mock". Leave empty to auto-detect
# (groq when GROQ_API_KEY is set, otherwise mock).
LLM_PROVIDER=

# Model id for the chosen provider (Groq default: llama-3.3-70b-versatile).
LLM_MODEL=llama-3.1-8b-instant

# Rows per AI batch (1-100). Larger = fewer calls but bigger prompts.
BATCH_SIZE=25

# Also write structured logs to ./logs/import-YYYY-MM-DD.log (in addition to stdout).
LOG_TO_FILE=false

# ── Frontend → Backend wiring ──────────────────────────────────────────────
# The frontend (Next, :3000) calls the standalone backend (Node, :4000) here.
# Point this at your deployed backend host in production. If you deploy the
# Next app on its own, leave it empty and the frontend calls the same-origin
# /api/import route instead.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Standalone backend server settings (server/index.mjs).
BACKEND_PORT=4000
# Browser origin allowed to call the backend (CORS). Match the frontend URL.
CORS_ORIGIN=http://localhost:3000
